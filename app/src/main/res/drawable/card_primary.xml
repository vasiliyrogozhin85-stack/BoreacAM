<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#123D59" android:endColor="#0D2940" />
            <stroke android:width="1dp" android:color="#65D1FF" />
            <padding android:left="16dp" android:top="15dp" android:right="16dp" android:bottom="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#0D2B40" android:endColor="#0B1D2A" />
            <stroke android:width="1dp" android:color="#39BFFF" />
            <padding android:left="16dp" android:top="15dp" android:right="16dp" android:bottom="15dp" />
        </shape>
    </item>
</selector>
