<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#172633" />
            <stroke android:width="1dp" android:color="#7EA4B9" />
            <padding android:left="16dp" android:top="15dp" android:right="16dp" android:bottom="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#111D26" android:endColor="#0A131A" />
            <stroke android:width="1dp" android:color="#496573" />
            <padding android:left="16dp" android:top="15dp" android:right="16dp" android:bottom="15dp" />
        </shape>
    </item>
</selector>
